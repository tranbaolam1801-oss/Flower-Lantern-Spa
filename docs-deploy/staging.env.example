# Flower Lantern Spa - STAGING environment template. PLACEHOLDERS ONLY: never commit real values.
# Copy to the host's secret store / a private .env. (`.env.*` is git-ignored, so this example lives in docs-deploy/.)

# NODE_ENV=production is recommended: Secure cookie forced, no Windows auth, DB_TRUST_CERTIFICATE ignored, payment mock off.
# NODE_ENV=staging also keeps the mock off (allowed only for test/development) but then set COOKIE_SECURE=true.
NODE_ENV=production
COOKIE_SECURE=true
HOST=127.0.0.1
PORT=3000
# Number of reverse-proxy hops in front of the backend (1 for a single proxy). Leave unset when no proxy.
TRUST_PROXY=1
# Exact browser origin; must be the same site (registrable domain) as the API because the cookie is SameSite=Lax.
FRONTEND_ORIGIN=https://<STAGING_FRONTEND_DOMAIN>

# SQL authentication (tedious). Dedicated staging database, never the dev or test one.
DB_HOST=<STAGING_SQL_HOST>
DB_PORT=1433
DB_NAME=<STAGING_DB_NAME>
DB_USER=<STAGING_DB_USER>
DB_PASSWORD=<SECRET>

JWT_SECRET=<RANDOM_32_BYTES_OR_MORE>
# sql requires migration 004 (session store) to be applied on the staging database.
AUTH_SESSION_STORE=sql

# Image uploads (UC_9.1). Must be a persistent volume on hosts with ephemeral disks.
UPLOAD_DIR=/var/lib/flower-lantern-spa/uploads

# SePay: Test Mode first. Mock is never enabled on staging.
SEPAY_WEBHOOK_AUTH=apikey
SEPAY_API_KEY=<SECRET_32_CHARS_OR_MORE>
SEPAY_WEBHOOK_SECRET=<SECRET_32_CHARS_OR_MORE_IF_HMAC>
SEPAY_ACCOUNT_NUMBER=<SEPAY_TEST_ACCOUNT>
SEPAY_BANK=<BANK_CODE>
SEPAY_ACCOUNT_HOLDER=<ACCOUNT_HOLDER>
SEPAY_PAYMENT_PREFIX=FLS
PAYMENT_EXPIRY_MINUTES=15
PAYMENT_MOCK_ENABLED=false

# Rate limiting (per process; defaults shown). RATE_LIMIT_ENABLED=false turns it off.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_WEBHOOK_PER_WINDOW=300
RATE_LIMIT_INTENT_PER_WINDOW=20
RATE_LIMIT_LOGIN_PER_WINDOW=20
RATE_LIMIT_UPLOAD_PER_WINDOW=30
