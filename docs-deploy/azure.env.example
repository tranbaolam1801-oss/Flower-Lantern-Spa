# Flower Lantern Spa — Azure App Service (F1) Application Settings template. PLACEHOLDERS ONLY.
# Paste these as "Application settings" in App Service → Configuration (NOT as a committed .env file;
# App Service injects them as process.env at container start). Never commit real values anywhere.

NODE_ENV=production
HOST=0.0.0.0
# App Service for Containers sets its own PORT at runtime (usually 8080) and maps it to 80/443 at the
# edge; leave PORT unset here and let the platform inject it, OR explicitly read it in main.ts (already
# does: `Number(process.env.PORT ?? 3000)`), so whichever value App Service injects is honored automatically.

# Cross-origin: frontend (Static Web Apps) and backend (App Service) are two different domains.
FRONTEND_ORIGIN=https://<YOUR_STATIC_WEB_APP>.azurestaticapps.net
COOKIE_SECURE=true
COOKIE_SAMESITE=none
TRUST_PROXY=1

# SQL Server (tedious). Azure SQL Database free tier server/database.
DB_HOST=<your-server>.database.windows.net
DB_PORT=1433
DB_NAME=<your-database>
DB_USER=<sql-login>
DB_PASSWORD=<SECRET>
# Azure SQL free tier auto-pauses after 15 minutes idle; raise timeouts and allow retries so the first
# request after a pause has a chance to succeed instead of failing outright.
DB_CONNECT_TIMEOUT_MS=30000
DB_REQUEST_TIMEOUT_MS=30000
DB_CONNECT_RETRIES=3
DB_CONNECT_RETRY_DELAY_MS=5000

JWT_SECRET=<RANDOM_32_BYTES_OR_MORE_BASE64>
AUTH_SESSION_STORE=sql

# Image uploads (UC_9.1). App Service Linux (code or container) persists /home across restarts within
# the same instance; it is NOT shared across scale-out instances. Fine for a single-instance F1 demo.
UPLOAD_DIR=/home/uploads

# SePay Test Mode. Never enable PAYMENT_MOCK_ENABLED here (only valid in test/development, and
# config.ts/payments.config.ts should reject it in production regardless).
SEPAY_WEBHOOK_AUTH=apikey
SEPAY_API_KEY=<SECRET_32_CHARS_OR_MORE>
SEPAY_WEBHOOK_SECRET=<SECRET_32_CHARS_OR_MORE_IF_HMAC>
SEPAY_ACCOUNT_NUMBER=<SEPAY_TEST_ACCOUNT>
SEPAY_BANK=<BANK_CODE>
SEPAY_ACCOUNT_HOLDER=<ACCOUNT_HOLDER>
SEPAY_PAYMENT_PREFIX=FLS
PAYMENT_EXPIRY_MINUTES=15
PAYMENT_MOCK_ENABLED=false

RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_WEBHOOK_PER_WINDOW=300
RATE_LIMIT_INTENT_PER_WINDOW=20
RATE_LIMIT_LOGIN_PER_WINDOW=20
RATE_LIMIT_UPLOAD_PER_WINDOW=30

# ---- Frontend build-time variable (Static Web Apps build pipeline, NOT an App Service setting) ----
# VITE_API_BASE_URL=https://<YOUR_APP_SERVICE>.azurewebsites.net
