# Copy thành .env và điền giá trị thật (KHÔNG commit file .env vào git)

# Bắt buộc đổi khi deploy production — dùng lệnh sau để sinh:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=django-insecure-change-this-in-production

# False khi deploy production
DJANGO_DEBUG=True

# Danh sách host, phân tách bằng dấu phẩy, ví dụ: spaana.com,www.spaana.com
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Cloudinary (bỏ trống để dùng local media/ khi dev)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# SendGrid (bỏ trống để email in ra console khi dev)
SENDGRID_API_KEY=
DEFAULT_FROM_EMAIL=Spa ANA <noreply@spaana.com>
