NODE_ENV=development
PORT=3000
FRONTEND_ORIGIN=http://127.0.0.1:5173
DB_HOST=localhost
# Set windows on Windows local development to use integrated authentication.
DB_AUTH=windows
DB_PORT=1433
DB_NAME=FlowerLanternSpa_Dev
DB_USER=
DB_PASSWORD=
DB_TRUST_CERTIFICATE=true
# Generate a private random value of at least 32 bytes; never commit it.
JWT_SECRET=
# Never connect migrations/tests to an existing customer database.
# SePay credentials will be added only with the verified integration milestone.
# Staged rollout: enable sql only against Test with migration 004 applied.
# Leave Dev legacy until separate approval. Never treat legacy logout as server revocation.
AUTH_SESSION_STORE=legacy



# SePay Test Mode (migration 007 PROPOSED/NOT APPLIED; values below are placeholders, set real ones only in your private .env)
SEPAY_WEBHOOK_AUTH=apikey
SEPAY_API_KEY="c5e501d504f363c0ec611dfa8de4653a4c597496ac9c1eaa4199f54e41b99e54"
SEPAY_WEBHOOK_SECRET=
SEPAY_ACCOUNT_NUMBER=
SEPAY_BANK=
SEPAY_ACCOUNT_HOLDER=
SEPAY_PAYMENT_PREFIX=FLS
SEPAY_QR_BASE=https://qr.sepay.vn/img
PAYMENT_EXPIRY_MINUTES=15
PAYMENT_MOCK_ENABLED=false
