ht: auto;\n  object-fit: contain;\n}\n.customer-header nav {\n  display: flex;\n  align-items: center;\n  gap: clamp(8px,1.5vw,24px);\n  margin: auto;\n  font-size: 15px;\n  white-space: nowrap;\n}\n.customer-header nav button {\n  background: none;\n}\n.customer-header-actions {\n  display: flex;\n  align-items: center;\n  gap: 14px;\n}\n.customer-header-actions>.account-menu {\n  padding-left: 14px;\n  border-left: 1px solid var(--color-customer-border);\n}\n.customer-header-actions>.account-menu summary {\n  height: 24px;\n}\n.customer-header-actions>button.header-book-cta {\n  height: 40px;\n  border-radius: 999px;\n  background: var(--color-customer-primary);\n  padding: 0 18px;\n  font-size: 14px;\n  font-weight: 600;\n  white-space: nowrap;\n}\n.customer-hero {\n  position: relative;\n  isolation: isolate;\n  height: 235px;\n  overflow: hidden;\n  flex-shrink: 0;\n  background: var(--color-hero);\n}\n.hero-left {\n  position: absolute;\n  z-index: -1;\n  left: 0;\n  top: 0;\n  width: 300px;\n  height: 235px;\n  object-fit: cover;\n}\n.hero-right {\n  position: absolute;\n  z-index: -1;\n  right: -72px;\n  top: 0;\n  width: 692px;\n  height: 235px;\n  object-fit: cover;\n}\n.customer-hero>div {\n  position: relative;\n  margin-left: 21.74%;\n  padding-top: 32px;\n  color: var(--color-customer-heading);\n}\n.customer-hero p {\n  font-size: 14px;\n  font-weight: 700;\n  position: relative;\n  margin: 0 0 12px;\n}\n.customer-hero p:after {\n  content: '';\n  position: absolute;\n  left: 0;\n  bottom: -6px;\n  width: 28px;\n  height: 2.5px;\n  background: var(--color-primary);\n}\n.customer-hero h1 {\n  font: 400 clamp(26px,2.5vw,36px)/1.25 'Noto Serif',serif;\n  margin: 0 0 10px;\n}\n.customer-hero span {\n  font-size: 15px;\n  line-height: 1.55;\n  color: var(--color-hero-text);\n}\n.customer-bookings {\n  padding: 28px min(48px,3.4%) 36px;\n  flex: 1;\n  width: min(1280px,100%);\n  margin-inline: auto;\n}\n.booking-filters {\n  display: flex;\n  justify-content