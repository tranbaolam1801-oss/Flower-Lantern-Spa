ute;\n  z-index: 10;\n  top: 150px;\n  left: clamp(0px,20vw,300px);\n  width: 320px;\n  max-width: 100%;\n  border: 1px solid var(--color-border);\n  border-radius: 16px;\n  padding: 20px;\n  background: white;\n  box-shadow: 0 6px 18px var(--color-shadow);\n}\n.booking-detail h2 {\n  font-size: 18px;\n  color: var(--color-calendar-heading);\n  margin-bottom: 12px;\n}\n.booking-detail p {\n  font-size: 15px;\n  margin-bottom: 8px;\n}\n.booking-detail-close {\n  position: absolute;\n  right: 8px;\n  top: 8px;\n  width: 32px;\n  height: 32px;\n}\n.cancel-booking-button {\n  background: var(--color-cancel-action);\n  color: white;\n}\n.cancel-booking-button:hover {\n  background: var(--color-cancel-action);\n}\n.booking-confirm-dialog {\n  margin: 24px auto;\n  border: 1px solid var(--color-border);\n  border-radius: 16px;\n  padding: 0;\n  width: min(600px,calc(100vw - 32px));\n  max-height: calc(100svh - 48px);\n  overflow: auto;\n  box-shadow: 4px 8px 0 var(--color-shadow);\n}\n.booking-confirm-dialog::backdrop {\n  background: rgb(0 0 0 / .4);\n}\n.booking-confirm-dialog h2 {\n  padding: 24px 32px 16px;\n  font-size: 28px;\n  font-weight: 700;\n  border-bottom: 1px solid var(--color-border);\n}\n.booking-confirm-dialog>p {\n  font-size: 19px;\n  padding: 32px 24px;\n  text-align: center;\n}\n.booking-confirm-dialog>div {\n  padding: 16px 20px 40px;\n  display: flex;\n  gap: 20px;\n  justify-content: flex-end;\n}\n.booking-confirm-dialog button {\n  min-height: 44px;\n}\n.booking-confirm-dialog [role=alert] {\n  color: var(--color-danger);\n  padding: 8px 24px;\n}\n@media (max-width:700px) {\n  .booking-detail {\n    left: 0;\n    top: 130px;\n  }\n  .booking-confirm-dialog h2 {\n    font-size: 24px;\n    padding: 20px;\n  }\n  .booking-confirm-dialog>p {\n    font-size: 16px;\n  }\n  .booking-confirm-dialog>div {\n    padding: 16px;\n    gap: 12px;\n    flex-wrap: wrap;\n  }\n}\n.brand-home-link {\n  display: inline-flex;\n  align-items: center;\n  text-decoration: none;\n}\n.customer-header nav button {\n  cursor: pointer;\n  border: 0;\n  color: var(--color-customer-text);\n  padding: 8px 14px;\n  border-radius: 10px;\n  transition: background .15s,color .15s;\n}\n.customer-header nav button:hover,.customer-header nav button.nav-link-active {\n  background: var(--color-filter-surface);\n  color: var(--color-heading);\n  font-weight: 600;\n}\n.header-icon-btn {\n  background: none;\n  border: 0;\n  padding: 6px;\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  border-radius: 8px;\n}\n.header-login-link {\n  border: 1px solid var(--color-border);\n  background: white;\n  color: var(--color-heading);\n  border-radius: 10px;\n  padding: 8px 14px;\n  font-size: 14px;\n  font-weight: 600;\n  white-space: nowrap;\n}\n.customer-header-actions>button.header-login-link {\n  display: inline-flex;\n}\n.public-shell {\n  min-height: 100svh;\n  display: flex;\n  flex-direction: column;\n  background: var(--color-customer-canvas);\n  color: var(--color-customer-text);\n}\n.home-container {\n  width: min(1240px,100%);\n  margin-inline: auto;\n  padding-inline: 24px;\n}\n.home-section {\n  padding-block: clamp(44px,6vw,76px);\n}\n.home-section-header {\n  text-align: center;\n  max-width: 720px;\n  margin: 0 auto 36px;\n}\n.home-section-tag {\n  display: inline-block;\n  font-size: 13px;\n  font-weight: 700;\n  letter-spacing: 1.2px;\n  color: var(--color-primary);\n  margin-bottom: 8px;\n  position: relative;\n}\n.home-section-header h2 {\n  font: 400 clamp(26px,3vw,36px)/1.3 'Noto Serif',serif;\n  color: var(--color-customer-heading);\n  margin: 0 0 12px;\n}\n.home-section-header p {\n  margin: 0;\n  color: var(--color-hero-text);\n  font-size: 16px;\n  line-height: 1.6;\n}\n.home-text-link {\n  color: var(--color-primary);\n  font-weight: 600;\n  text-decoration: none;\n}\n.home-text-link:hover {\n  text-decoration: underline;\n}\n.home-hero {\n  position: relative;\n  isolation: isolate;\n  overflow: hidden;\n  background: var(--color-hero);\n  min-height: clamp(380px,46vw,500px);\n  display: flex;\n  align-items: center;\n}\n.home-hero-bg {\n  position: absolute;\n  inset: 0;\n  width: 100%;\n  height: 100%;\n  object-fit: cover;\n  z-index: -1;\n  opacity: .9;\n}\n.home-hero-inner {\n  width: min(1240px,100%);\n  margin-inline: auto;\n  padding: 48px 24px;\n}\n.home-hero-copy {\n  max-width: 600px;\n  background: rgb(255 255 255 / .88);\n  backdrop-filter: blur(4px);\n  padding: clamp(20px,3vw,32px);\n  border-radius: 20px;\n  border: 1px solid var(--color-border);\n}\n.home-eyebrow {\n  font-size: 12px;\n  font-weight: 700;\n  letter-spacing: 1.4px;\n  color: var(--color-primary);\n}\n.home-hero-copy h1 {\n  font: 400 clamp(28px,3.6vw,44px)/1.25 'Noto Serif',serif;\n  color: var(--color-customer-heading);\n  margin: 10px 0 14px;\n}\n.home-hero-copy p {\n  margin: 0 0 22px;\n  color: var(--color-hero-text);\n  font-size: 16px;\n  line-height: 1.65;\n}\n.home-hero-actions {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 12px;\n}\n.home-hero-book-btn {\n  background: white;\n  color: var(--color-heading);\n  border-color: var(--color-primary);\n}\n.home-hero-actions button img {\n  width: 18px;\n  height: 18px;\n  filter: brightness(0) saturate(100%) invert(26%) sepia(24%) saturate(1020%) hue-rotate(90deg);\n}\n.home-about {\n  background: white;\n}\n.home-about-grid {\n  display: grid;\n  grid-template-columns: minmax(0,1fr) minmax(0,1.25fr);\n  gap: clamp(24px,4vw,48px);\n  align-items: center;\n}\n.home-about-media {\n  border-radius: 20px;\n  overflow: hidden;\n  border: 1px solid var(--color-border);\n  background: var(--color-hero);\n  aspect-ratio: 4/3;\n}\n.home-about-media img {\n  width: 100%;\n  height: 100%;\n  object-fit: cover;\n  display: block;\n}\n.home-about-body h2 {\n  font: 400 clamp(26px,3vw,34px)/1.3 'Noto Serif',serif;\n  color: var(--color-customer-heading);\n  margin: 6px 0 14px;\n}\n.home-about-body p {\n  color: var(--color-hero-text);\n  line-height: 1.7;\n  margin: 0 0 12px;\n}\n.home-about-pillars {\n  display: grid;\n  grid-template-columns: repeat(3,minmax(0,1fr));\n  gap: 12px;\n  margin-top: 20px;\n}\n.home-about-pillars>div {\n  background: var(--color-customer-canvas);\n  border: 1px solid var(--color-border);\n  border-radius: 14px;\n  padding: 14px;\n}\n.home-about-pillars strong {\n  display: block;\n  color: var(--color-heading);\n  font-size: 14px;\n  margin-bottom: 4px;\n}\n.home-about-pillars span {\n  font-size: 13px;\n  color: var(--color-muted);\n}\n.home-services-grid,.catalog-grid {\n  display: grid;\n  grid-template-columns: repeat(4,minmax(0,1fr));\n  gap: 20px;\n}\n.home-service-card {\n  background: white;\n  border: 1px solid var(--color-customer-border);\n  border-radius: 18px;\n  overflow: hidden;\n  display: flex;\n  flex-direction: column;\n  transition: box-shadow .18s;\n}\n.home-service-card:hover {\n  box-shadow: 0 8px 22px var(--color-shadow);\n}\n.home-service-thumb {\n  aspect-ratio: 16/10;\n  background: var(--color-hero);\n  overflow: hidden;\n}\n.home-service-thumb img {\n  width: 100%;\n  height: 100%;\n  object-fit: cover;\n  display: block;\n}\n.home-service-body {\n  padding: 18px;\n  display: flex;\n  flex-direction: column;\n  gap: 10px;\n  flex: 1;\n}\n.home-service-body h3 {\n  margin: 0;\n  font-size: 17px;\n  font-weight: 700;\n  color: var(--color-customer-heading);\n}\n.home-service-body p {\n  margin: 0;\n  font-size: 14px;\n  color: var(--color-customer-muted);\n  line-height: 1.55;\n  flex: 1;\n}\n.home-service-footer {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 8px;\n  margin-top: 8px;\n}\n.home-service-footer strong {\n  color: var(--color-heading);\n  font-size: 16px;\n}\n.home-detail-pill {\n  background: var(--color-filter-surface);\n  color: var(--color-heading);\n  padding: 7px 14px;\n  border-radius: 999px;\n  font-size: 13px;\n  font-weight: 600;\n  text-decoration: none;\n  white-space: nowrap;\n}\n.home-why {\n  background: var(--color-hero);\n}\n.home-why-grid {\n  display: grid;\n  grid-template-columns: repeat(4,minmax(0,1fr));\n  gap: 18px;\n}\n.home-why-card {\n  background: white;\n  border: 1px solid var(--color-border);\n  border-radius: 16px;\n  padding: 22px;\n}\n.home-why-card h3 {\n  margin: 0 0 8px;\n  color: var(--color-heading);\n  font-size: 17px;\n}\n.home-why-card p {\n  margin: 0;\n  color: var(--color-muted);\n  font-size: 14px;\n  line-height: 1.6;\n}\n.home-gallery-grid {\n  display: grid;\n  grid-template-columns: repeat(4,minmax(0,1fr));\n  gap: 16px;\n}\n.home-gallery-item {\n  margin: 0;\n  border-radius: 16px;\n  overflow: hidden;\n  border: 1px solid var(--color-border);\n  aspect-ratio: 4/3;\n  background: white;\n}\n.home-gallery-item img {\n  width: 100%;\n  height: 100%;\n  object-fit: cover;\n  display: block;\n}\n.home-reviews-grid {\n  display: grid;\n  grid-template-columns: repeat(3,minmax(0,1fr));\n  gap: 18px;\n}\n.home-review-card {\n  background: white;\n  border: 1px solid var(--color-customer-border);\n  border-radius: 16px;\n  padding: 20px;\n  display: flex;\n  flex-direction: column;\n  gap: 8px;\n}\n.home-review-head {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  gap: 8px;\n}\n.home-review-head span {\n  color: #e0a800;\n}\n.home-state-box {\n  background: white;\n  border: 1px solid var(--color-customer-border);\n  border-radius: 16px;\n  padding: 28px;\n  text-align: center;\n  color: var(--color-customer-muted);\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  gap: 12px;\n}\n.home-cta-card {\n  position: relative;\n  overflow: hidden;\n  background: white;\n  border: 1px solid var(--color-border);\n  border-radius: 24px;\n  padding: clamp(24px,4vw,44px);\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 24px;\n  box-shadow: 0 8px 24px var(--color-shadow);\n}\n.home-cta-decor {\n  width: 110px;\n  height: 110px;\n  object-fit: cover;\n  border-radius: 16px;\n  flex-shrink: 0;\n}\n.home-cta-text {\n  flex: 1;\n}\n.home-cta-text h2 {\n  font: 400 clamp(24px,3vw,32px)/1.3 'Noto Serif',serif;\n  color: var(--color-customer-heading);\n  margin: 0 0 8px;\n}\n.home-cta-text p {\n  margin: 0;\n  color: var(--color-hero-text);\n}\n.home-cta-button {\n  background: var(--color-primary);\n  color: white;\n  border-radius: 999px;\n  padding-inline: 28px;\n  height: 48px;\n  font-weight: 700;\n  gap: 10px;\n  flex-shrink: 0;\n}\n.home-cta-button img {\n  width: 18px;\n  height: 18px;\n}\n.home-contact-grid {\n  display: grid;\n  grid-template-columns: minmax(0,1fr) minmax(0,1fr);\n  gap: 24px;\n  align-items: stretch;\n}\n.home-contact-card {\n  background: white;\n  border: 1px solid var(--color-customer-border);\n  border-radius: 18px;\n  padding: 24px;\n}\n.home-contact-list {\n  margin: 0;\n  display: flex;\n  flex-direction: column;\n  gap: 16px;\n}\n.home-contact-list dt {\n  font-size: 13px;\n  font-weight: 700;\n  color: var(--color-primary);\n  margin-bottom: 4px;\n}\n.home-contact-list dd {\n  margin: 0;\n  font-size: 15px;\n  color: var(--color-customer-heading);\n}\n.home-contact-map-placeholder {\n  position: relative;\n  border-radius: 18px;\n  overflow: hidden;\n  border: 1px solid var(--color-border);\n  min-height: 220px;\n}\n.home-contact-map-placeholder img {\n  width: 100%;\n  height: 100%;\n  object-fit: cover;\n  display: block;\n}\n.home-map-pin {\n  position: absolute;\n  left: 16px;\n  bottom: 16px;\n  background: rgb(255 255 255 / .94);\n  border: 1px solid var(--color-border);\n  border-radius: 12px;\n  padding: 10px 16px;\n}\n.home-map-pin strong {\n  display: block;\n  color: var(--color-heading);\n  font-size: 15px;\n}\n.home-map-pin span {\n  font-size: 13px;\n  color: var(--color-muted);\n}\n.public-footer {\n  background: #2d4728;\n  color: #eaf2e6;\n  padding: 48px 24px 24px;\n  margin-top: auto;\n}\n.public-footer-inner {\n  width: min(1240px,100%);\n  margin: 0 auto 32px;\n  display: grid;\n  grid-template-columns: 1.5fr 1fr 1fr 1fr;\n  gap: 28px;\n}\n.public-footer-logo-wrap {\n  background: white;\n  display: inline-block;\n  padding: 8px 14px;\n  border-radius: 12px;\n  margin-bottom: 14px;\n}\n.public-footer-logo {\n  width: 190px;\n  height: auto;\n}\n.public-footer-brand p {\n  font-size: 14px;\n  line-height: 1.6;\n  color: #d6e4d0;\n  margin: 0 0 12px;\n}\n.public-footer-meta {\n  list-style: none;\n  padding: 0;\n  margin: 0;\n  display: flex;\n  flex-direction: column;\n  gap: 6px;\n  font-size: 13px;\n  color: #d6e4d0;\n}\n.public-footer-col h3 {\n  font-size: 15px;\n  font-weight: 700;\n  color: white;\n  margin: 0 0 12px;\n}\n.public-footer-col ul {\n  list-style: none;\n  padding: 0;\n  margin: 0;\n  display: flex;\n  flex-direction: column;\n  gap: 8px;\n  font-size: 14px;\n}\n.public-footer-col a {\n  color: #d6e4d0;\n  text-decoration: none;\n}\n.public-footer-col a:hover {\n  color: white;\n  text-decoration: underline;\n}\n.public-footer-bottom {\n  width: min(1240px,100%);\n  margin: 0 auto;\n  padding-top: 18px;\n  border-top: 1px solid rgb(255 255 255 / .15);\n  display: flex;\n  flex-wrap: wrap;\n  justify-content: space-between;\n  gap: 12px;\n  font-size: 13px;\n  color: #c3d6bc;\n}\n.catalog-main,.service-detail-main,.booking-page-main {\n  width: min(1240px,100%);\n  margin: 0 auto;\n  padding: 32px 24px 48px;\n  flex: 1;\n}\n.catalog-toolbar {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 14px;\n  align-items: center;\n  justify-content: space-between;\n  margin-bottom: 28px;\n}\n.catalog-search-box {\n  display: flex;\n  align-items: center;\n  gap: 10px;\n  border: 1px solid var(--color-customer-border);\n  background: white;\n  border-radius: 12px;\n  padding: 10px 14px;\n  min-width: 260px;\n  flex: 1;\n  max-width: 420px;\n}\n.catalog-search-box input {\n  border: 0;\n  outline: 0;\n  width: 100%;\n  font-size: 15px;\n}\n.catalog-category-pills {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 8px;\n}\n.catalog-category-pills button {\n  border: 0;\n  border-radius: 999px;\n  padding: 10px 18px;\n  background: var(--color-filter-surface);\n  color: var(--color-heading);\n  font-size: 14px;\n}\n.catalog-category-pills button[aria-pressed=\"true\"] {\n  background: var(--color-primary);\n  color: white;\n  font-weight: 700;\n}\n.service-detail-topbar {\n  display: flex;\n  flex-wrap: wrap;\n  justify-content: space-between;\n  gap: 12px;\n  margin-bottom: 24px;\n  font-size: 14px;\n}\n.service-breadcrumb a {\n  color: var(--color-muted);\n  text-decoration: none;\n}\n.service-detail-hero {\n  display: grid;\n  grid-template-columns: minmax(0,1fr) minmax(0,1.15fr);\n  gap: 28px;\n  margin-bottom: 32px;\n}\n.service-detail-image {\n  border-radius: 20px;\n  border: 1px solid var(--color-customer-border);\n  background: white;\n  overflow: hidden;\n  aspect-ratio: 4/3;\n}\n.service-detail-image img {\n  width: 100%;\n  height: 100%;\n  object-fit: cover;\n  display: block;\n}\n.service-detail-summary {\n  display: flex;\n  flex-direction: column;\n  gap: 14px;\n}\n.service-detail-summary h1 {\n  font: 400 clamp(26px,3vw,36px)/1.3 'Noto Serif',serif;\n  color: var(--color-customer-heading);\n  margin: 0;\n}\n.service-badge-active {\n  background: #eaf6eb;\n  color: #357c46;\n  padding: 5px 12px;\n  border-radius: 999px;\n  font-size: 12px;\n  font-weight: 700;\n}\n.service-meta-row {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 20px;\n  align-items: center;\n}\n.service-price-lg {\n  font-size: 22px;\n  color: var(--color-heading);\n}\n.service-packages-box {\n  background: white;\n  border: 1px solid var(--color-customer-border);\n  border-radius: 16px;\n  padding: 18px;\n}\n.service-packages-box h2 {\n  font-size: 17px;\n  margin: 0 0 12px;\n  color: var(--color-heading);\n}\n.service-packages-box ul {\n  list-style: none;\n  padding: 0;\n  margin: 0;\n  display: flex;\n  flex-direction: column;\n  gap: 10px;\n}\n.service-packages-box li {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  padding: 12px 14px;\n  background: var(--color-customer-canvas);\n  border: 1px solid var(--color-border);\n  border-radius: 12px;\n}\n.service-packages-box li small {\n  display: block;\n  color: var(--color-muted);\n}\n.service-info-grid {\n  display: grid;\n  grid-template-columns: repeat(2,minmax(0,1fr));\n  gap: 20px;\n}\n.service-info-card {\n  background: white;\n  border: 1px solid var(--color-customer-border);\n  border-radius: 16px;\n  padding: 22px;\n}\n.service-info-card h3 {\n  margin: 0 0 12px;\n  color: var(--color-heading);\n  font-size: 18px;\n}\n.service-info-card ul,.service-info-card ol {\n  margin: 0;\n  padding-left: 20px;\n  display: flex;\n  flex-direction: column;\n  gap: 8px;\n  color: var(--color-hero-text);\n}\n.booking-auth-banner {\n  display: flex;\n  flex-wrap: wrap;\n  align-items: center;\n  justify-content: space-between;\n  gap: 12px;\n  background: #fff4dc;\n  border: 1px solid #e0af50;\n  border-radius: 14px;\n  padding: 14px 18px;\n  margin-bottom: 24px;\n}\n.booking-two-col {\n  display: grid;\n  grid-template-columns: minmax(0,1.6fr) minmax(0,1fr);\n  gap: 24px;\n  align-items: start;\n}\n.booking-form-card,.booking-summary-card,.booking-success-card {\n  background: white;\n  border: 1px solid var(--color-customer-border);\n  border-radius: 20px;\n  padding: 24px;\n}\n.booking-form-card {\n  display: flex;\n  flex-direction: column;\n  gap: 16px;\n}\n.booking-form-card h2,.booking-summary-card h2 {\n  font-size: 18px;\n  color: var(--color-customer-heading);\n  margin: 8px 0 0;\n  display: flex;\n  align-items: center;\n  gap: 10px;\n}\n.step-circle {\n  width: 26px;\n  height: 26px;\n  border-radius: 50%;\n  background: var(--color-filter-surface);\n  color: var(--color-heading);\n  display: inline-grid;\n  place-items: center;\n  font-size: 13px;\n  font-weight: 700;\n}\n.booking-form-grid-2 {\n  display: grid;\n  grid-template-columns: repeat(2,minmax(0,1fr));\n  gap: 14px;\n}\n.booking-form-grid-3 {\n  display: grid;\n  grid-template-columns: repeat(3,minmax(0,1fr));\n  gap: 14px;\n}\n.booking-summary-card dl {\n  margin: 16px 0 0;\n  display: flex;\n  flex-direction: column;\n  gap: 12px;\n}\n.booking-summary-card dl>div {\n  display: flex;\n  justify-content: space-between;\n  gap: 12px;\n  padding-bottom: 10px;\n  border-bottom: 1px solid var(--color-table-divider);\n  font-size: 14px;\n}\n.booking-summary-card dt {\n  color: var(--color-muted);\n}\n.booking-summary-card dd {\n  margin: 0;\n  text-align: right;\n  font-weight: 600;\n}\n.booking-success-card {\n  text-align: center;\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  gap: 14px;\n  padding: 40px 24px;\n}\n.booking-success-actions {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 12px;\n}\n.spa-field {\n  display: flex;\n  flex-direction: column;\n  gap: 6px;\n  font-size: 14px;\n}\n.spa-field>span {\n  font-weight: 600;\n  color: var(--color-heading);\n}\n.spa-field>span em {\n  color: var(--color-danger);\n  font-style: normal;\n}\n.spa-field input,.spa-field select,.spa-field textarea {\n  border: 1px solid var(--color-border);\n  border-radius: 10px;\n  padding: 10px 12px;\n  background: white;\n  font-size: 14px;\n  min-width: 0;\n  width: 100%;\n}\n.spa-select-toolbar {\n  height: 50px;\n  border: 1px solid var(--color-customer-search-border);\n  border-radius: 13px;\n  padding: 0 14px;\n  background: white;\n  font-size: 14px;\n}\n.spa-checkbox-row {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n  font-size: 14px;\n  cursor: pointer;\n}\n.spa-form-error {\n  color: var(--color-danger);\n  background: #fff0f2;\n  border: 1px solid #eaa;\n  border-radius: 10px;\n  padding: 10px 14px;\n  font-size: 14px;\n  margin: 0;\n}\n.spa-toast-success {\n  background: #eaf6eb;\n  border: 1px solid #98c286;\n  color: #275d34;\n  border-radius: 12px;\n  padding: 12px 16px;\n  margin-bottom: 16px;\n  font-size: 14px;\n  font-weight: 600;\n}\n.spa-modal {\n  margin: auto;\n  border: 1px solid var(--color-border);\n  border-radius: 20px;\n  padding: 0;\n  width: min(620px,calc(100vw - 24px));\n  max-height: calc(100svh - 32px);\n  overflow: auto;\n  background: white;\n  box-shadow: 0 16px 40px rgb(21 61 42 / .2);\n}\n.spa-modal-lg {\n  width: min(840px,calc(100vw - 24px));\n}\n.spa-modal::backdrop {\n  background: var(--color-backdrop);\n}\n.spa-modal-header {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  padding: 18px 24px;\n  border-bottom: 1px solid var(--color-border);\n}\n.spa-modal-header h2 {\n  margin: 0;\n  font-size: 20px;\n  color: var(--color-heading);\n}\n.spa-modal-close {\n  background: none;\n  border: 0;\n  font-size: 24px;\n  line-height: 1;\n  padding: 4px 8px;\n  color: var(--color-muted);\n}\n.spa-modal-body {\n  padding: 20px 24px;\n  display: flex;\n  flex-direction: column;\n  gap: 14px;\n}\n.spa-modal-footer {\n  padding: 16px 24px;\n  border-top: 1px solid var(--color-border);\n  display: flex;\n  justify-content: flex-end;\n  gap: 12px;\n  flex-wrap: wrap;\n}\n.spa-section-subtitle {\n  font-size: 15px;\n  color: var(--color-primary);\n  margin: 6px 0 0;\n}\n.booking-guest-box {\n  background: var(--color-customer-canvas);\n  border: 1px solid var(--color-border);\n  border-radius: 14px;\n  padding: 14px;\n  display: flex;\n  flex-direction: column;\n  gap: 12px;\n}\n.table-action-row {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 8px;\n  align-items: center;\n}\n.table-action-row button {\n  height: 34px;\n  padding: 0 12px;\n  font-size: 13px;\n}\n.danger-outline-btn {\n  border-color: #eaa;\n  color: var(--color-cancel-action);\n}\n.pill-status {\n  display: inline-block;\n  padding: 5px 12px;\n  border-radius: 999px;\n  font-size: 12px;\n  font-weight: 700;\n}\n.pill-ok {\n  background: #eaf6eb;\n  color: #357c46;\n}\n.pill-warn {\n  background: #fff0f2;\n  color: var(--color-danger);\n}\n.role-subchip {\n  display: block;\n  font-size: 12px;\n  color: var(--color-muted);\n  margin-top: 2px;\n}\n.star-cell {\n  color: #e0a800;\n  font-size: 15px;\n  white-space: nowrap;\n}\n.star-picker {\n  display: flex;\n  gap: 8px;\n}\n.star-btn {\n  background: none;\n  border: 0;\n  font-size: 28px;\n  color: #ccc;\n  padding: 0 4px;\n}\n.star-btn.active {\n  color: #e0a800;\n}\n.detail-kv-list {\n  margin: 0;\n  display: flex;\n  flex-direction: column;\n  gap: 10px;\n}\n.detail-kv-list>div {\n  display: flex;\n  justify-content: space-between;\n  gap: 16px;\n  padding-bottom: 8px;\n  border-bottom: 1px solid var(--color-table-divider);\n  font-size: 14px;\n}\n.detail-kv-list dt {\n  color: var(--color-muted);\n}\n.detail-kv-list dd {\n  margin: 0;\n  font-weight: 600;\n  text-align: right;\n}\n.review-quote {\n  margin: 0;\n  padding: 14px;\n  background: var(--color-canvas);\n  border-radius: 12px;\n  border: 1px solid var(--color-border);\n}\n.review-reply-box {\n  padding: 14px;\n  background: #eaf6eb;\n  border-radius: 12px;\n  border: 1px solid #98c286;\n}\n.review-no-reply {\n  padding: 14px;\n  background: #fff0f2;\n  border-radius: 12px;\n  color: var(--color-danger);\n  margin: 0;\n}\n.perm-checklist {\n  display: flex;\n  flex-direction: column;\n  gap: 8px;\n  padding: 12px;\n  background: var(--color-customer-canvas);\n  border: 1px solid var(--color-border);\n  border-radius: 12px;\n}\n.admin-panel-card {\n  background: white;\n  border: 1px solid var(--color-customer-search-border);\n  border-radius: 18px;\n  padding: 22px;\n}\n.admin-page-title {\n  font-size: 22px;\n  color: var(--color-heading);\n  margin: 0 0 18px;\n}\n.overview-grid {\n  display: grid;\n  grid-template-columns: repeat(3,minmax(0,1fr));\n  gap: 16px;\n  margin-top: 20px;\n}\n.overview-card {\n  border: 1px solid var(--color-border);\n  border-radius: 16px;\n  padding: 20px;\n  background: var(--color-customer-canvas);\n  text-decoration: none;\n  color: inherit;\n  display: flex;\n  flex-direction: column;\n  gap: 8px;\n}\n.overview-card:hover {\n  border-color: var(--color-primary);\n  box-shadow: 0 6px 18px var(--color-shadow);\n}\n.overview-badge {\n  align-self: flex-start;\n  background: var(--color-filter-surface);\n  color: var(--color-heading);\n  font-size: 12px;\n  font-weight: 700;\n  padding: 3px 10px;\n  border-radius: 999px;\n}\n.overview-card h2 {\n  margin: 0;\n  font-size: 17px;\n  color: var(--color-heading);\n}\n.overview-card p {\n  margin: 0;\n  font-size: 14px;\n  color: var(--color-muted);\n  flex: 1;\n}\n.calendar-toolbar-extended {\n  flex-wrap: wrap;\n  height: auto;\n  gap: 12px;\n}\n.calendar-toolbar-right {\n  margin-left: auto;\n  display: flex;\n  gap: 10px;\n  flex-wrap: wrap;\n}\n.calendar-toolbar-right button {\n  width: auto;\n  font-size: 15px;\n  padding-inline: 18px;\n}\n.booking-detail-actions {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 8px;\n  margin-top: 12px;\n}\n.sepay-panel {\n  display: grid;\n  grid-template-columns: 200px minmax(0,1fr);\n  gap: 20px;\n  align-items: center;\n}\n.sepay-qr-box {\n  border: 1px solid var(--color-border);\n  border-radius: 14px;\n  padding: 12px;\n  background: white;\n  display: grid;\n  place-items: center;\n  aspect-ratio: 1/1;\n}\n.sepay-qr-box img {\n  width: 100%;\n  height: 100%;\n  object-fit: contain;\n}\n.sepay-amount {\n  font-size: 18px;\n  font-weight: 700;\n  color: var(--color-primary);\n}\n.sepay-status.paid {\n  color: #357c46;\n  font-weight: 700;\n}\n.sepay-note {\n  font-size: 13px;\n  color: var(--color-muted);\n}\n.reports-stack {\n  display: flex;\n  flex-direction: column;\n  gap: 20px;\n}\n.reports-filter-card {\n  background: white;\n  border: 1px solid var(--color-customer-search-border);\n  border-radius: 16px;\n  padding: 18px;\n  display: flex;\n  flex-wrap: wrap;\n  gap: 16px;\n  align-items: flex-end;\n}\n.reports-kpi-grid {\n  display: grid;\n  grid-template-columns: repeat(3,minmax(0,1fr));\n  gap: 16px;\n}\n.reports-kpi-card {\n  background: white;\n  border: 1px solid var(--color-customer-search-border);\n  border-radius: 16px;\n  padding: 20px;\n  display: flex;\n  flex-direction: column;\n  gap: 8px;\n}\n.reports-kpi-card span {\n  font-size: 14px;\n  color: var(--color-muted);\n}\n.reports-kpi-card strong {\n  font-size: 26px;\n  color: var(--color-heading);\n}\n.reports-chart-head {\n  display: flex;\n  flex-wrap: wrap;\n  justify-content: space-between;\n  align-items: center;\n  gap: 12px;\n  margin-bottom: 18px;\n}\n.reports-chart-head h2 {\n  margin: 0;\n  font-size: 18px;\n  color: var(--color-heading);\n}\n.reports-granularity {\n  display: flex;\n  gap: 8px;\n}\n.reports-granularity button {\n  border: 1px solid var(--color-border);\n  background: white;\n  border-radius: 8px;\n  padding: 6px 14px;\n  font-size: 13px;\n}\n.reports-granularity button[aria-pressed=\"true\"] {\n  background: var(--color-primary);\n  color: white;\n  border-color: var(--color-primary);\n  font-weight: 700;\n}\n.reports-bars {\n  display: flex;\n  align-items: flex-end;\n  gap: 10px;\n  overflow-x: auto;\n  padding-top: 16px;\n  min-height: 180px;\n}\n.reports-bar-col {\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  gap: 6px;\n  min-width: 44px;\n  flex: 1;\n}\n.reports-bar-fill {\n  width: 100%;\n  max-width: 34px;\n  background: var(--color-primary);\n  border-radius: 6px 6px 0 0;\n}\n.reports-bottom-grid {\n  display: grid;\n  grid-template-columns: repeat(2,minmax(0,1fr));\n  gap: 16px;\n}\n@media (max-width:1100px) {\n  .home-services-grid,.catalog-grid,.home-why-grid,.home-gallery-grid {\n    grid-template-columns: repeat(2,minmax(0,1fr));\n  }\n  .public-footer-inner {\n    grid-template-columns: repeat(2,minmax(0,1fr));\n  }\n  .overview-grid {\n    grid-template-columns: repeat(2,minmax(0,1fr));\n  }\n}\n@media (max-width:850px) {\n  .home-about-grid,.service-detail-hero,.booking-two-col,.home-contact-grid,.home-reviews-grid,.reports-bottom-grid,.service-info-grid,.reports-kpi-grid {\n    grid-template-columns: minmax(0,1fr);\n  }\n  .booking-form-grid-3,.booking-form-grid-2 {\n    grid-template-columns: minmax(0,1fr);\n  }\n  .sepay-panel {\n    grid-template-columns: minmax(0,1fr);\n  }\n  .home-cta-card {\n    flex-direction: column;\n    text-align: center;\n  }\n  .home-about-pillars {\n    grid-template-columns: minmax(0,1fr);\n  }\n}\n@media (max-width:600px) {\n  .home-services-grid,.catalog-grid,.home-why-grid,.home-gallery-grid,.public-footer-inner,.overview-grid {\n    grid-template-columns: minmax(0,1fr);\n  }\n  .customer-header-actions>button.header-login-link {\n    display: none;\n  }\n}\n.customer-hero-hoian {\n  position: relative;\n  isolation: isolate;\n  height: 235px;\n  min-height: 235px;\n  overflow: hidden;\n  flex-shrink: 0;\n  background: var(--color-hero);\n}\n.hero-hoian-banner {\n  position: absolute;\n  inset: 0;\n  width: 100%;\n  height: 100%;\n  object-fit: cover;\n  object-position: center;\n  z-index: -1;\n}\n.customer-hero-hoian .hero-copy-box {\n  position: relative;\n  margin-left: clamp(24px,20.5vw,295px);\n  padding-top: 34px;\n  max-width: 540px;\n  padding-right: 24px;\n}\n.customer-hero-hoian .hero-copy-box p {\n  display: inline-flex;\n  align-items: center;\n  gap: 12px;\n  font-size: 13px;\n  font-weight: 700;\n  letter-spacing: .6px;\n  color: var(--color-customer-heading);\n  margin: 0 0 10px;\n  position: relative;\n}\n.customer-hero-hoian .hero-copy-box p::after {\n  content: '';\n  position: absolute;\n  left: 0;\n  bottom: -6px;\n  width: 26px;\n  height: 2.5px;\n  background: var(--color-primary);\n}\n.hero-eyebrow-line {\n  display: inline-block;\n  width: 30px;\n  height: 1.5px;\n  background: var(--color-border);\n}\n.customer-hero-hoian h1 {\n  font: 400 clamp(26px,2.5vw,36px)/1.25 'Noto Serif',serif;\n  color: var(--color-customer-heading);\n  margin: 2px 0 10px;\n}\n.customer-hero-hoian span {\n  display: block;\n  font-size: 15px;\n  line-height: 1.55;\n  color: var(--color-hero-text);\n}\n.catalog-main,.service-detail-main,.booking-page-main {\n  width: min(1260px,100%);\n  margin: 0 auto;\n  padding: 28px 24px 44px;\n  flex: 1;\n}\n.catalog-search-wrapper {\n  max-width: 760px;\n  margin: 0 auto 20px;\n}\n.catalog-search-pill {\n  display: flex;\n  align-items: center;\n  gap: 10px;\n  height: 52px;\n  background: white;\n  border: 1.5px solid var(--color-border);\n  border-radius: 999px;\n  padding: 5px 5px 5px 18px;\n  box-shadow: 0 4px 12px rgb(21 61 42 / .04);\n}\n.catalog-search-pill:focus-within {\n  border-color: var(--color-primary);\n}\n.catalog-search-pill.invalid {\n  border-color: var(--color-danger);\n}\n.catalog-search-pill img {\n  width: 18px;\n  height: 18px;\n  flex-shrink: 0;\n}\n.catalog-search-pill input {\n  border: 0;\n  outline: 0;\n  flex: 1;\n  min-width: 0;\n  font-size: 14.5px;\n  background: transparent;\n}\n.catalog-search-btn {\n  border-radius: 999px;\n  height: 40px;\n  padding-inline: 22px;\n  font-size: 14px;\n  font-weight: 600;\n  flex-shrink: 0;\n}\n.catalog-search-error {\n  margin: 6px 0 0 18px;\n  color: var(--color-danger);\n  font-size: 13px;\n}\n.catalog-category-pills {\n  display: flex;\n  flex-wrap: wrap;\n  justify-content: center;\n  gap: 10px;\n  margin-bottom: 28px;\n}\n.catalog-category-pills button {\n  display: inline-flex;\n  align-items: center;\n  gap: 7px;\n  border: 0;\n  border-radius: 999px;\n  height: 38px;\n  padding: 0 16px;\n  background: var(--color-filter-surface);\n  color: var(--color-heading);\n  font-size: 13.5px;\n  font-weight: 500;\n}\n.catalog-category-pills button[aria-pressed=\"true\"] {\n  background: var(--color-primary);\n  color: white;\n  font-weight: 700;\n}\n.catalog-fixture-section {\n  display: flex;\n  flex-direction: column;\n  gap: 18px;\n}\n.catalog-fixture-banner {\n  display: flex;\n  flex-wrap: wrap;\n  align-items: center;\n  justify-content: space-between;\n  gap: 12px;\n  background: #fff4dc;\n  border: 1px solid #e0af50;\n  border-radius: 14px;\n  padding: 12px 18px;\n  font-size: 13.5px;\n  color: #6c470b;\n}\n.figma-service-card {\n  background: white;\n  border: 1px solid var(--color-customer-border);\n  border-radius: 16px;\n  padding: 12px;\n  display: flex;\n  flex-direction: column;\n  gap: 10px;\n  transition: box-shadow .18s;\n}\n.figma-service-card:hover {\n  box-shadow: 0 8px 20px var(--color-shadow);\n}\n.figma-service-thumb {\n  aspect-ratio: 16/10;\n  border-radius: 10px;\n  overflow: hidden;\n  background: var(--color-hero);\n}\n.figma-service-thumb img {\n  width: 100%;\n  height: 100%;\n  object-fit: cover;\n  display: block;\n}\n.figma-service-meta {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 8px;\n  font-size: 12px;\n}\n.figma-cat-badge {\n  background: var(--color-filter-surface);\n  color: var(--color-heading);\n  padding: 4px 10px;\n  border-radius: 999px;\n  font-weight: 600;\n}\n.figma-dur-label {\n  color: var(--color-customer-muted);\n  font-weight: 500;\n}\n.figma-service-body {\n  display: flex;\n  flex-direction: column;\n  gap: 6px;\n  flex: 1;\n}\n.figma-service-body h3 {\n  margin: 0;\n  font-size: 16px;\n  font-weight: 700;\n  color: var(--color-customer-heading);\n  line-height: 1.35;\n}\n.figma-service-body p {\n  margin: 0;\n  font-size: 13px;\n  color: var(--color-customer-muted);\n  line-height: 1.5;\n  display: -webkit-box;\n  -webkit-line-clamp: 2;\n  -webkit-box-orient: vertical;\n  overflow: hidden;\n  flex: 1;\n}\n.figma-service-footer {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 8px;\n  margin-top: 6px;\n}\n.figma-service-footer strong {\n  font-size: 18px;\n  font-weight: 700;\n  color: var(--color-heading);\n}\n.figma-detail-pill {\n  background: var(--color-filter-surface);\n  color: var(--color-heading);\n  padding: 6px 12px;\n  border-radius: 999px;\n  font-size: 12.5px;\n  font-weight: 600;\n  text-decoration: none;\n  white-space: nowrap;\n}\n.figma-detail-pill:hover {\n  background: var(