e:disabled {\n    pointer-events: none;\n  }\n  .disabled\\:opacity-50:disabled {\n    opacity: 50%;\n  }\n}\n:root {\n  font-family: Inter,sans-serif;\n  color: var(--color-text);\n  background: var(--color-canvas);\n  font-synthesis: none;\n}\n* {\n  box-sizing: border-box;\n}\nbody {\n  margin: 0;\n}\nbutton {\n  cursor: pointer;\n}\nbutton,input {\n  font: inherit;\n}\nbutton:focus-visible,input:focus-visible {\n  outline: 2px solid var(--color-primary);\n  outline-offset: 3px;\n}\n.login-page {\n  position: relative;\n  min-height: 100svh;\n  overflow: hidden;\n  padding: 132px 20px 80px;\n  display: flex;\n  justify-content: center;\n}\n.login-decoration {\n  position: absolute;\n  right: 0;\n  bottom: 0;\n  width: 520px;\n  height: 390px;\n  object-fit: cover;\n  opacity: .72;\n  pointer-events: none;\n}\n.login-column {\n  position: relative;\n  width: 520px;\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  gap: 20px;\n}\n.brand-logo {\n  width: 180px;\n  height: 135px;\n  object-fit: contain;\n}\n.login-card {\n  width: 100%;\n  background: white;\n  border: 1px solid var(--color-border);\n  border-radius: 24px;\n  padding: 24px;\n  display: flex;\n  flex-direction: column;\n  gap: 12px;\n}\n.login-card header {\n  text-align: center;\n  display: flex;\n  flex-direction: column;\n  gap: 10px;\n}\n.login-card h1 {\n  margin: 0;\n  color: var(--color-heading);\n  font-size: 29px;\n  font-weight: 700;\n  line-height: 1.3;\n  letter-spacing: -.6px;\n}\n.login-card header p {\n  margin: 0;\n  font-size: 14px;\n  line-height: 1.6;\n  color: var(--color-muted);\n}\n.login-fields {\n  display: flex;\n  flex-direction: column;\n  gap: 12px;\n}\n.field {\n  display: flex;\n  flex-direction: column;\n  gap: 8px;\n}\n.field label {\n  font-size: 14px;\n  font-weight: 600;\n  line-height: normal;\n}\n.field label span {\n  color: var(--color-danger);\n}\n.input-wrap {\n  height: 54px;\n  border: 1px solid var(--color-border);\n  border-radius: 12p