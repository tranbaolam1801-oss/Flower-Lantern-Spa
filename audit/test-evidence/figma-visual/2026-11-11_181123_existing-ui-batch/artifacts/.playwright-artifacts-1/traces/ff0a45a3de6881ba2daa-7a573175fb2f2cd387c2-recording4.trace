;\n}\n.system-page p {\n  margin: 20px 0;\n}\n.remember-row,.register-row {\n  line-height: normal;\n}\n.login-actions>button {\n  font-weight: 700;\n  line-height: normal;\n}\n.remember-row input {\n  appearance: none;\n  border: 1.5px solid var(--color-primary);\n  border-radius: 4px;\n  background: white;\n}\n.remember-row input:checked {\n  background: var(--color-primary);\n  box-shadow: inset 0 0 0 3px white;\n}\n@media (max-width:600px) {\n  .login-page {\n    padding-top: 40px;\n  }\n  .login-column {\n    width: min(520px,100%);\n  }\n  .login-card {\n    padding: 20px;\n  }\n  .login-card h1 {\n    font-size: 26px;\n  }\n  .remember-row {\n    flex-wrap: wrap;\n  }\n  .login-decoration {\n    max-width: 100%;\n    height: auto;\n    aspect-ratio: 4/3;\n  }\n}\n.admin-shell {\n  display: flex;\n  min-height: 100svh;\n  background: linear-gradient(90deg,var(--color-white),var(--color-workspace) 55%,var(--color-canvas));\n  color: var(--color-text);\n}\n.admin-sidebar {\n  position: relative;\n  flex: 0 0 278px;\n  min-height: 900px;\n  border-right: 1px solid var(--color-border);\n  padding: 26px 12px;\n  background: linear-gradient(var(--color-sidebar) 65%,var(--color-canvas));\n  overflow: hidden;\n}\n.sidebar-lotus {\n  position: absolute;\n  bottom: 0;\n  left: 0;\n  width: 260px;\n  height: 273px;\n  object-fit: cover;\n  pointer-events: none;\n}\n.admin-brand {\n  height: 154px;\n  display: flex;\n  align-items: center;\n  flex-direction: column;\n  gap: 12px;\n  position: relative;\n}\n.admin-brand img {\n  width: 94px;\n  height: 56px;\n  object-fit: cover;\n}\n.admin-brand strong {\n  font-size: 18px;\n  letter-spacing: -.6px;\n  color: var(--color-heading);\n}\n.admin-sidebar nav {\n  position: relative;\n  display: flex;\n  flex-direction: column;\n  gap: 12px;\n}\n.admin-sidebar nav button {\n  height: 50px;\n  border: 0;\n  background: transparent;\n  display: flex;\n  align-items: center;\n  gap: 16px;\n  padding: 0 20px;\n  border-radius: 12px