  position: absolute;\n  z-index: 10;\n  top: 150px;\n  left: clamp(0px,20vw,300px);\n  width: 320px;\n  max-width: 100%;\n  border: 1px solid var(--color-border);\n  border-radius: 16px;\n  padding: 20px;\n  background: white;\n  box-shadow: 0 6px 18px var(--color-shadow);\n}\n.booking-detail h2 {\n  font-size: 18px;\n  color: var(--color-calendar-heading);\n  margin-bottom: 12px;\n}\n.booking-detail p {\n  font-size: 15px;\n  margin-bottom: 8px;\n}\n.booking-detail-close {\n  position: absolute;\n  right: 8px;\n  top: 8px;\n  width: 32px;\n  height: 32px;\n}\n.cancel-booking-button {\n  background: var(--color-cancel-action);\n  color: white;\n}\n.cancel-booking-button:hover {\n  background: var(--color-cancel-action);\n}\n.booking-confirm-dialog {\n  margin: 24px auto;\n  border: 1px solid var(--color-border);\n  border-radius: 16px;\n  padding: 0;\n  width: min(600px,calc(100vw - 32px));\n  max-height: calc(100svh - 48px);\n  overflow: auto;\n  box-shadow: 4px 8px 0 var(--color-shadow);\n}\n.booking-confirm-dialog::backdrop {\n  background: rgb(0 0 0 / .4);\n}\n.booking-confirm-dialog h2 {\n  padding: 24px 32px 16px;\n  font-size: 28px;\n  font-weight: 700;\n  border-bottom: 1px solid var(--color-border);\n}\n.booking-confirm-dialog>p {\n  font-size: 19px;\n  padding: 32px 24px;\n  text-align: center;\n}\n.booking-confirm-dialog>div {\n  padding: 16px 20px 40px;\n  display: flex;\n  gap: 20px;\n  justify-content: flex-end;\n}\n.booking-confirm-dialog button {\n  min-height: 44px;\n}\n.booking-confirm-dialog [role=alert] {\n  color: var(--color-danger);\n  padding: 8px 24px;\n}\n@media (max-width:700px) {\n  .booking-detail {\n    left: 0;\n    top: 130px;\n  }\n  .booking-confirm-dialog h2 {\n    font-size: 24px;\n    padding: 20px;\n  }\n  .booking-confirm-dialog>p {\n    font-size: 16px;\n  }\n  .booking-confirm-dialog>div {\n    padding: 16px;\n    gap: 12px;\n    flex-wrap: wrap;\n  }\n}\n.brand-home-link {\n  display: inline-flex;\n  align-items: center;\n 