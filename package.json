{
  "name": "flower-lantern-spa",
  "private": true,
  "version": "0.1.0",
  "workspaces": ["backend", "frontend"],
  "engines": {"node": ">=22.12.0"},
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm run dev -w backend\" \"npm run dev -w frontend\"",
    "build": "npm run build --workspaces",
    "typecheck": "npm run typecheck --workspaces",
    "lint": "eslint backend/src frontend/src tests",
    "test": "npm run test -w backend",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0", "eslint": "^9.39.0", "typescript-eslint": "^8.46.0",
    "typescript": "~5.9.3", "concurrently": "^9.2.1", "@playwright/test": "^1.56.1"
  }
}
